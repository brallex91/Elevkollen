@* Criterion rows under one work area. Each row has its own grade step and
   comment, and is saved as a separate assessment. *@

<MudStack Spacing="3">
    @foreach (var row in Rows)
    {
        var index = Rows.IndexOf(row);

        <MudPaper Elevation="0" Class="criterion-card pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Kriterium @(index + 1)</MudText>

                @if (Rows.Count > 1)
                {
                    <MudTooltip Text="Ta bort kriteriet">
                        <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                       Color="Color.Default" aria-label="Ta bort kriteriet"
                                       OnClick="@(() => Remove(row))" />
                    </MudTooltip>
                }
            </MudStack>

            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudAutocomplete T="string" @bind-Value="row.CentralContent"
                                     SearchFunc="SearchContentAsync" Label="Centralt innehåll"
                                     Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                     MaxItems="null" Placeholder="Sök i centralt innehåll"
                                     PopoverClass="criterion-popover">
                        <ItemTemplate Context="item">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@HeadingFor(item)</MudText>
                            <MudText Typo="Typo.body2" Class="picker-item">@item</MudText>
                        </ItemTemplate>
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12">
                    <MudAutocomplete T="CriterionChoiceDto" Value="row.Choice"
                                     ValueChanged="@(c => CriterionChanged(row, c))"
                                     SearchFunc="SearchCriteriaAsync" Label="Betygskriterium"
                                     ToStringFunc="@(c => c?.Text ?? "")"
                                     Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                     MaxItems="null" Placeholder="Sök bland betygskriterier"
                                     PopoverClass="criterion-popover">
                        <ItemTemplate Context="choice">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@choice.Label</MudText>
                            <MudText Typo="Typo.body2" Class="picker-item">
                                <CriterionText Criterion="@choice.Variants.FirstOrDefault()" Fallback="@choice.Text" />
                            </MudText>
                        </ItemTemplate>
                    </MudAutocomplete>

                    @if (!HasCriteria)
                    {
                        @* An unexplained empty list reads as a broken app. *@
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                            Skolverket har inga betygskriterier för det här ämnet i @SpanLabel.
                            Betyg sätts först i årskurs 6. Välj centralt innehåll och skriv en
                            kommentar i stället, eller byt årskursspann.
                        </MudText>
                    }
                </MudItem>

                @if (row.Choice is { } choice)
                {
                    <MudItem xs="12">
                        @* The input is single-line, so the full criterion text is shown here. *@
                        <MudPaper Elevation="0" Class="criterion-panel pa-4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@choice.Label</MudText>
                            <MudText Typo="Typo.body2" Class="picker-item mt-1">
                                <CriterionText Criterion="@row.SelectedVariant" Fallback="@choice.Text" />
                            </MudText>

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Välj det betygssteg som eleven motsvarar. Skillnaden ligger i värdeorden.
                            </MudText>

                            <MudRadioGroup T="string" Value="@row.GradeStep"
                                           ValueChanged="@(s => row.GradeStep = s)"
                                           Class="criterion-steps mt-2">
                                @foreach (var v in choice.Variants)
                                {
                                    <MudRadio T="string" Value="@v.GradeStep" Dense="true"
                                              Color="Color.Primary" Class="criterion-step">
                                        <MudText Typo="Typo.body2">
                                            <strong>@ProgressText.StepLabel(v.GradeStep)</strong>
                                            @if (v.ValueWords.Count > 0)
                                            {
                                                <span class="mud-text-secondary"> — @string.Join(" · ", v.ValueWords)</span>
                                            }
                                        </MudText>
                                    </MudRadio>
                                }

                                @* Skolverket has no criterion text for F, so the option belongs in the UI. *@
                                <MudRadio T="string" Value="@ProgressText.NotPassedStep" Dense="true"
                                          Color="Color.Error" Class="criterion-step">
                                    <MudText Typo="Typo.body2">
                                        <strong>@ProgressText.StepLabel(ProgressText.NotPassedStep)</strong>
                                        <span class="mud-text-secondary"> — kriteriet är inte uppnått</span>
                                    </MudText>
                                </MudRadio>
                            </MudRadioGroup>
                        </MudPaper>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField Value="row.Comment" ValueChanged="@((string? v) => row.Comment = v)"
                                  T="string" Label="Kommentar" Lines="2" Variant="Variant.Outlined"
                                  Placeholder="Frivillig kommentar för det här kriteriet" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <div>
        <MudButton StartIcon="@Icons.Material.Rounded.Add" Variant="Variant.Outlined"
                   Color="Color.Primary" OnClick="Add" Disabled="@(Syllabus is null)">
            Lägg till betygskriterium
        </MudButton>
    </div>
</MudStack>

@code {
    /// <summary>The rows being edited. Owned by the caller so it can save them.</summary>
    [Parameter, EditorRequired] public List<CriterionRow> Rows { get; set; } = [];

    /// <summary>The syllabus for the selected subject, loaded by <see cref="SyllabusPicker"/>.</summary>
    [Parameter] public SyllabusDto? Syllabus { get; set; }

    /// <summary>Selected year span, e.g. "4-6".</summary>
    [Parameter] public string? YearSpan { get; set; }

    private IReadOnlyList<CriterionChoiceDto>? _choices;
    private SyllabusDto? _builtFor;

    /// <summary>Criteria grouped by year and paragraph index, built once per syllabus.</summary>
    private IReadOnlyList<CriterionChoiceDto> Choices
    {
        get
        {
            // Reference check: SyllabusDto is a record, so value equality would deep
            // compare the whole syllabus on every render.
            if (!ReferenceEquals(_builtFor, Syllabus))
            {
                _builtFor = Syllabus;
                _choices = CriterionGroup.Build(Syllabus?.GradingCriteria ?? []);
            }

            return _choices ?? [];
        }
    }

    private bool HasCriteria => Syllabus is null || CriteriaForSpan.Any();

    private string SpanLabel => YearSpan is null ? "valt spann" : $"årskurs {YearSpan}";

    /// <summary>Always scoped to the selected span. Showing the wrong year is worse than showing none.</summary>
    private IEnumerable<CriterionChoiceDto> CriteriaForSpan =>
        YearSpans.CriterionYears(YearSpan) is { Length: > 0 } years
            ? Choices.Where(c => years.Contains(c.Year))
            : Choices;

    private Task<IEnumerable<string>> SearchContentAsync(string? text, CancellationToken _) =>
        Task.FromResult(Syllabus?.CentralContents
            .Where(c => c.YearSpan == YearSpan)
            .SelectMany(c => c.Items)
            .Where(i => Matches(i, text))
            .Distinct(StringComparer.Ordinal) ?? []);

    private Task<IEnumerable<CriterionChoiceDto>> SearchCriteriaAsync(string? text, CancellationToken _) =>
        Task.FromResult(CriteriaForSpan.Where(c => Matches(c.Text, text)));

    private static bool Matches(string value, string? text) =>
        string.IsNullOrWhiteSpace(text) || value.Contains(text, StringComparison.OrdinalIgnoreCase);

    private string HeadingFor(string item) =>
        Syllabus?.CentralContents.FirstOrDefault(c => c.YearSpan == YearSpan && c.Items.Contains(item))?.Heading ?? "";

    /// <summary>
    /// A single variant means the grade step is implied. Otherwise the teacher picks
    /// a step by comparing the value words.
    /// </summary>
    private void CriterionChanged(CriterionRow row, CriterionChoiceDto? choice)
    {
        row.Choice = choice;

        row.GradeStep = choice switch
        {
            null => null,
            { Variants.Count: 1 } => choice.Variants[0].GradeStep,
            _ when row.GradeStep == ProgressText.NotPassedStep => row.GradeStep,
            _ when choice.Variants.Any(v => v.GradeStep == row.GradeStep) => row.GradeStep,
            _ => null,
        };

        StateHasChanged();
    }

    private void Add() => Rows.Add(new CriterionRow());

    private void Remove(CriterionRow row) => Rows.Remove(row);

    /// <summary>One row under the work area. Saved as its own assessment.</summary>
    public sealed class CriterionRow
    {
        /// <summary>Id of the saved assessment, null for a new row.</summary>
        public int? Id { get; set; }

        public string? CentralContent { get; set; }
        public CriterionChoiceDto? Choice { get; set; }
        public string? GradeStep { get; set; }
        public string? Comment { get; set; }

        public CriterionDto? SelectedVariant =>
            Choice?.Variants.FirstOrDefault(v => v.GradeStep == GradeStep);

        /// <summary>Text for the selected grade step, otherwise the criterion base text.</summary>
        public string? CriterionText => SelectedVariant?.Text ?? Choice?.Text;

        public bool IsComplete => Choice is not null && GradeStep is not null;
    }
}
