@inject SyllabusClient Api

@* Gemensam läroplansväljare: ämne, arbetsområde, centralt innehåll och betygskriterium.
   Används både för enskild bedömning och för klassbedömning. *@

<MudGrid Spacing="3">
    <MudItem xs="12" sm="@(ShowDate ? 6 : 12)">
        <MudAutocomplete T="SubjectDto" Value="_subject" ValueChanged="SubjectChangedAsync"
                         SearchFunc="SearchSubjectsAsync" ToStringFunc="@(s => s?.Name ?? "")"
                         Label="Ämne" Variant="Variant.Outlined" Required="true"
                         Clearable="true" ResetValueOnEmptyText="true" CoerceText="true"
                         MaxItems="null" Placeholder="Sök ämne">
            <ItemTemplate Context="s">
                <MudText Typo="Typo.body2">@s.Name</MudText>
            </ItemTemplate>
        </MudAutocomplete>
    </MudItem>

    @if (ShowDate)
    {
        <MudItem xs="12" sm="6">
            <MudDatePicker Date="Date" DateChanged="DateChanged" Label="Datum" Variant="Variant.Outlined" />
        </MudItem>
    }

    <MudItem xs="12">
        <MudTextField Value="WorkArea" ValueChanged="@((string? v) => WorkAreaChanged.InvokeAsync(v))"
                      T="string" Label="Arbetsområde" Placeholder="t.ex. Bråk och procent"
                      Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" />
    </MudItem>

    @if (_loading)
    {
        <MudItem xs="12">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </MudItem>
    }
    else if (_syllabus is not null)
    {
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="_yearSpan" @bind-Value:after="YearSpanChangedAsync"
                       Label="Årskursspann" Variant="Variant.Outlined">
                @foreach (var y in _yearSpans)
                {
                    <MudSelectItem T="string" Value="@y">Årskurs @y</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @if (ShowCriterion)
        {
            <MudItem xs="12" sm="8">
                <MudAutocomplete T="string" Value="CentralContent"
                                 ValueChanged="@((string? v) => CentralContentChanged.InvokeAsync(v))"
                                 SearchFunc="SearchContentAsync" Label="Centralt innehåll"
                                 Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                 MaxItems="null" Placeholder="Sök i centralt innehåll">
                    <ItemTemplate Context="item">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@HeadingFor(item)</MudText>
                        <MudText Typo="Typo.body2" Class="picker-item">@item</MudText>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>

            <MudItem xs="12">
                <MudAutocomplete T="CriterionChoiceDto" Value="_choice" ValueChanged="CriterionChangedAsync"
                                 SearchFunc="SearchCriteriaAsync" Label="Betygskriterium"
                                 ToStringFunc="@(c => c?.Text ?? "")"
                                 Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                 MaxItems="null" Placeholder="Sök bland betygskriterier"
                                 PopoverClass="criterion-popover">
                    <ItemTemplate Context="choice">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@choice.Label</MudText>
                        <MudText Typo="Typo.body2" Class="picker-item">
                            <CriterionText Criterion="@choice.Variants.FirstOrDefault()" Fallback="@choice.Text" />
                        </MudText>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>

            @if (_choice is not null)
            {
                <MudItem xs="12">
                    @* Inmatningsfältet är enradigt, så hela kriterietexten visas här. *@
                    <MudPaper Elevation="0" Class="criterion-panel pa-4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_choice.Label</MudText>
                        <MudText Typo="Typo.body2" Class="picker-item mt-1">
                            @* Visar den valda variantens text, så att värdeorden matchar betygssteget. *@
                            <CriterionText Criterion="@_selectedVariant" Fallback="@_choice.Text" />
                        </MudText>

                        @if (_choice.Variants.Count > 1)
                        {
                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Välj det betygssteg som eleven motsvarar. Skillnaden ligger i värdeorden.
                            </MudText>

                            <MudRadioGroup T="string" Value="@GradeStep" ValueChanged="GradeStepChangedAsync"
                                           Class="criterion-steps mt-2">
                                @foreach (var v in _choice.Variants)
                                {
                                    <MudRadio T="string" Value="@v.GradeStep" Dense="true"
                                              Color="Color.Primary" Class="criterion-step">
                                        <MudText Typo="Typo.body2">
                                            <strong>@ProgressText.StepLabel(v.GradeStep)</strong>
                                            @if (v.ValueWords.Count > 0)
                                            {
                                                <span class="mud-text-secondary"> — @string.Join(" · ", v.ValueWords)</span>
                                            }
                                        </MudText>
                                    </MudRadio>
                                }
                            </MudRadioGroup>
                        }
                    </MudPaper>
                </MudItem>
            }
        }
    }
</MudGrid>

@code {
    [Parameter] public string? SubjectCode { get; set; }
    [Parameter] public EventCallback<string?> SubjectCodeChanged { get; set; }

    [Parameter] public string? SubjectName { get; set; }
    [Parameter] public EventCallback<string?> SubjectNameChanged { get; set; }

    [Parameter] public string? WorkArea { get; set; }
    [Parameter] public EventCallback<string?> WorkAreaChanged { get; set; }

    [Parameter] public string? CentralContent { get; set; }
    [Parameter] public EventCallback<string?> CentralContentChanged { get; set; }

    [Parameter] public string? GradingCriterion { get; set; }
    [Parameter] public EventCallback<string?> GradingCriterionChanged { get; set; }

    /// <summary>Valt betygssteg. Sätts när läraren jämfört värdeorden och valt nivå.</summary>
    [Parameter] public string? GradeStep { get; set; }
    [Parameter] public EventCallback<string?> GradeStepChanged { get; set; }

    /// <summary>Årskurs och styckeindex för valt kriterium, så det kan återfinnas exakt.</summary>
    [Parameter] public EventCallback<(int? Year, int? Index)> CriterionIdentityChanged { get; set; }

    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback<DateTime?> DateChanged { get; set; }

    [Parameter] public bool ShowDate { get; set; } = true;

    /// <summary>
    /// Falskt när anroparen själv renderar kriterierna, t.ex. när ett arbetsområde
    /// rymmer flera kriterier. Då används pickern bara till ämne, datum och spann.
    /// </summary>
    [Parameter] public bool ShowCriterion { get; set; } = true;

    /// <summary>Läroplanen och valt spann, så anroparen slipper hämta dem en gång till.</summary>
    [Parameter] public EventCallback<(SyllabusDto? Syllabus, string? YearSpan)> SyllabusChanged { get; set; }

    /// <summary>Elevens eller klassens årskurs. Styr vilket årskursspann som förifylls.</summary>
    [Parameter] public int? SchoolYear { get; set; }

    private IReadOnlyList<SubjectDto> _subjects = [];
    private SubjectDto? _subject;
    private SyllabusDto? _syllabus;
    private IReadOnlyList<CriterionChoiceDto>? _choices;
    private CriterionChoiceDto? _choice;

    /// <summary>Varianten för valt betygssteg, så att värdeorden matchar steget.</summary>
    private CriterionDto? _selectedVariant =>
        _choice?.Variants.FirstOrDefault(v => v.GradeStep == GradeStep);
    private string[] _yearSpans = [];
    private string? _yearSpan;

    // Senast notifierade värden, så att anroparen inte väcks i onödan.
    private SyllabusDto? _notifiedSyllabus;
    private string? _notifiedSpan;
    private string? _subjectCode;
    private int? _appliedSchoolYear;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _subjects = await Api.GetSubjectsAsync();
        _subjectCode = SubjectCode;
        _subject = _subjects.FirstOrDefault(s => s.Code == _subjectCode);

        if (!string.IsNullOrWhiteSpace(_subjectCode))
        {
            await LoadSyllabusAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Klassen kan bytas medan komponenten lever. Följ med tills läraren väljer själv.
        if (SchoolYear != _appliedSchoolYear)
        {
            _appliedSchoolYear = SchoolYear;
            var span = SpanFor(SchoolYear);

            if (span is not null && _yearSpans.Contains(span))
            {
                _yearSpan = span;
            }
        }

        await NotifySyllabusAsync();
    }

    /// <summary>
    /// Anroparen filtrerar på spannet, så den måste få veta varje gång det ändras.
    /// Spannet sätts på flera ställen (laddning, klassbyte, val i listan) och
    /// notifieringen samlas därför här i stället för att upprepas i varje anropare.
    /// </summary>
    private async Task NotifySyllabusAsync()
    {
        if (ReferenceEquals(_syllabus, _notifiedSyllabus) && _yearSpan == _notifiedSpan)
        {
            return;
        }

        _notifiedSyllabus = _syllabus;
        _notifiedSpan = _yearSpan;

        await SyllabusChanged.InvokeAsync((_syllabus, _yearSpan));
    }

    /// <summary>Årskurs 1–3, 4–6 respektive 7–9 mappas till Skolverkets spann.</summary>
    private static string? SpanFor(int? year) => year switch
    {
        >= 1 and <= 3 => "1-3",
        >= 4 and <= 6 => "4-6",
        >= 7 and <= 9 => "7-9",
        _ => null,
    };

    private Task<IEnumerable<SubjectDto>> SearchSubjectsAsync(string? text, CancellationToken _) =>
        Task.FromResult(_subjects.Where(s =>
            string.IsNullOrWhiteSpace(text) ||
            s.Name.Contains(text, StringComparison.OrdinalIgnoreCase)).DistinctBy(s => s.Code));

    private Task<IEnumerable<string>> SearchContentAsync(string? text, CancellationToken _)
    {
        var items = _syllabus?.CentralContents
            .Where(c => c.YearSpan == _yearSpan)
            .SelectMany(c => c.Items)
            .Where(i => string.IsNullOrWhiteSpace(text) || i.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.Ordinal)
            ?? [];

        return Task.FromResult(items);
    }

    /// <summary>Betygskriterier sätts vid slutet av varje spann: 1-3 → åk 3, 4-6 → åk 6, 7-9 → åk 9.</summary>
    private static int? CriterionYearFor(string? span) => span switch
    {
        "1-3" => 3,
        "4-6" => 6,
        "7-9" => 9,
        _ => null,
    };

    private Task<IEnumerable<CriterionChoiceDto>> SearchCriteriaAsync(string? text, CancellationToken _)
    {
        var year = CriterionYearFor(_yearSpan);

        var items = Choices
            .Where(c => year is null || c.Year == year)
            .Where(c => string.IsNullOrWhiteSpace(text) || c.Text.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(items);
    }

    /// <summary>Kriterierna grupperade per årskurs och styckeindex, byggda en gång per läroplan.</summary>
    private IReadOnlyList<CriterionChoiceDto> Choices =>
        _choices ??= CriterionGroup.Build(_syllabus?.GradingCriteria ?? []);

    /// <summary>Byter läraren spann gäller varken innnehållet eller kriteriet längre.</summary>
    private async Task YearSpanChangedAsync()
    {
        _choice = null;
        await CentralContentChanged.InvokeAsync(null);
        await GradingCriterionChanged.InvokeAsync(null);
        await CriterionIdentityChanged.InvokeAsync((null, null));
        await NotifySyllabusAsync();
        StateHasChanged();
    }

    private string HeadingFor(string item) =>
        _syllabus?.CentralContents.FirstOrDefault(c => c.YearSpan == _yearSpan && c.Items.Contains(item))?.Heading ?? "";

    private async Task SubjectChangedAsync(SubjectDto? subject)
    {
        _subject = subject;
        _subjectCode = subject?.Code;
        await SubjectCodeChanged.InvokeAsync(_subjectCode);
        await SubjectNameChanged.InvokeAsync(subject?.Name);
        await LoadSyllabusAsync();
    }

    private async Task LoadSyllabusAsync()
    {
        if (string.IsNullOrWhiteSpace(_subjectCode))
        {
            _syllabus = null;
            _choices = null;
            _choice = null;
            _yearSpans = [];
            await NotifySyllabusAsync();
            return;
        }

        _loading = true;
        _syllabus = await Api.GetSyllabusAsync(_subjectCode);
        _choices = null;
        _choice = null;
        _yearSpans = _syllabus?.CentralContents.Select(c => c.YearSpan).Distinct().ToArray() ?? [];

        if (_yearSpan is null || !_yearSpans.Contains(_yearSpan))
        {
            _yearSpan = (SpanFor(SchoolYear) is { } s && _yearSpans.Contains(s) ? s : null)
                ?? _yearSpans.FirstOrDefault();
        }

        _loading = false;
        await NotifySyllabusAsync();
    }

    /// <summary>
    /// Läraren väljer kriteriet först. Betygssteget väljs sedan bland varianterna,
    /// utom när kriteriet bara finns i en version (årskurs 1 och 3) då det sätts direkt.
    /// </summary>
    private async Task CriterionChangedAsync(CriterionChoiceDto? choice)
    {
        _choice = choice;

        await GradingCriterionChanged.InvokeAsync(choice?.Text);
        await CriterionIdentityChanged.InvokeAsync((choice?.Year, choice?.Index));

        if (choice is null)
        {
            await GradeStepChangedAsync(null);
            return;
        }

        if (choice.Variants.Count == 1)
        {
            await GradeStepChangedAsync(choice.Variants[0].GradeStep);
        }
        else if (GradeStep is not null && !choice.Variants.Any(v => v.GradeStep == GradeStep))
        {
            await GradeStepChangedAsync(null);
        }
    }

    /// <summary>Betygssteget bestämmer vilken formulering av kriteriet som sparas.</summary>
    private async Task GradeStepChangedAsync(string? step)
    {
        await GradeStepChanged.InvokeAsync(step);

        var variant = _choice?.Variants.FirstOrDefault(v => v.GradeStep == step);
        if (variant is not null)
        {
            await GradingCriterionChanged.InvokeAsync(variant.Text);
        }
    }
}
