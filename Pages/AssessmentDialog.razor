@inject StudentStore Store

<MudDialog>
    <DialogContent>
        <SyllabusPicker @bind-SubjectCode="_subjectCode"
                        @bind-SubjectName="_subjectName"
                        @bind-WorkArea="_workArea"
                        @bind-Date="_date"
                        SchoolYear="SchoolYear"
                        ShowCriterion="false"
                        SyllabusChanged="OnSyllabusChanged" />

        @if (_syllabus is not null)
        {
            <MudDivider Class="my-4" />

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1" Class="flex-grow-1">
                    @(string.IsNullOrWhiteSpace(_workArea) ? "Betygskriterier" : _workArea)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @_rows.Count @(_rows.Count == 1 ? "kriterium" : "kriterier")
                </MudText>
            </MudStack>

            <CriterionRows Rows="_rows" Syllabus="_syllabus" YearSpan="_yearSpan" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Avbryt</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(!CanSave)" OnClick="SaveAsync">
            Spara
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public int StudentId { get; set; }

    /// <summary>Elevens årskurs, används för att förifylla årskursspannet.</summary>
    [Parameter] public int? SchoolYear { get; set; }

    /// <summary>Null = ny bedömning.</summary>
    [Parameter] public AssessmentDto? Assessment { get; set; }

    private string? _subjectCode;
    private string? _subjectName;
    private string? _workArea;
    private DateTime? _date = DateTime.Today;
    private SyllabusDto? _syllabus;
    private string? _yearSpan;
    private bool _busy;
    private bool _restored;

    private readonly List<CriterionRows.CriterionRow> _rows = [new()];

    /// <summary>Minst en ifylld rad krävs, och ämnet måste vara valt.</summary>
    private bool CanSave =>
        !_busy
        && !string.IsNullOrWhiteSpace(_subjectCode)
        && _rows.Any(r => r.IsComplete);

    protected override void OnInitialized()
    {
        if (Assessment is { } a)
        {
            _subjectCode = a.SubjectCode;
            _subjectName = a.SubjectName;
            _workArea = a.WorkArea;
            _date = a.Date.ToDateTime(TimeOnly.MinValue);

            _rows[0].Id = a.Id;
            _rows[0].CentralContent = a.CentralContent;
            _rows[0].GradeStep = a.GradeStep;
            _rows[0].Comment = a.Comment;
        }
    }

    private void OnSyllabusChanged((SyllabusDto? Syllabus, string? YearSpan) e)
    {
        _syllabus = e.Syllabus;
        _yearSpan = e.YearSpan;

        RestoreExistingCriterion();
        StateHasChanged();
    }

    /// <summary>
    /// Vid redigering är bara kriterietexten sparad. Kriteriet återfinns i läroplanen
    /// via årskurs och styckeindex, så betygsvalet kan visas som vid nyskapande.
    /// </summary>
    private void RestoreExistingCriterion()
    {
        if (_restored || _syllabus is null || Assessment is not { } a)
        {
            return;
        }

        _restored = true;

        var choices = CriterionGroup.Build(_syllabus.GradingCriteria);

        _rows[0].Choice = (a.CriterionYear, a.CriterionIndex) switch
        {
            (int y, int i) => choices.FirstOrDefault(c => c.Year == y && c.Index == i),
            _ => choices.FirstOrDefault(c => c.Variants.Any(v => v.Text == a.GradingCriterion)),
        };
    }

    private async Task SaveAsync()
    {
        _busy = true;

        var date = DateOnly.FromDateTime(_date ?? DateTime.Today);

        // Varje kriterium sparas som en egen bedömning, så statistiken blir individuell.
        var items = _rows
            .Where(r => r.IsComplete)
            .Select(r => (r.Id, new SaveAssessmentRequest(
                StudentId, _subjectCode!, _subjectName ?? "", _workArea, r.CentralContent,
                r.CriterionText, r.GradeStep, ProgressText.ProgressFor(r.GradeStep), r.Comment,
                date, r.Choice?.Year, r.Choice?.Index)))
            .ToArray();

        await Store.SaveAssessmentsAsync(items);

        Dialog.Close(DialogResult.Ok(true));
    }
}
